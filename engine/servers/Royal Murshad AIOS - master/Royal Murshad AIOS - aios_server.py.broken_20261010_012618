@app.post("/api/studio/manuscript/split")
async def studio_manuscript_split(request: _Req_studio):
    body = await request.json()
    text = (body.get("text") or "").strip()
    max_chars = int(body.get("max_chars", 500))
    if not text:
        return {"ok": False, "error": "no text"}
    import re as _re_srv
    sentences = _re_srv.split(r"(?<=[.!?])\s+", text)
    segments = []
    current = ""
    for sent in sentences:
        sent = sent.strip()
        if not sent:
            continue
        if len(current) + len(sent) + 1 <= max_chars:
            current = (current + " " + sent).strip() if current else sent
        else:
            if current:
                segments.append(current)
            current = sent
    if current:
        segments.append(current)
    return {"ok": True, "segments": segments, "count": len(segments), "total_chars": len(text)}

