import sqlite3 as _sql12
import hashlib as _hash12
import hmac as _hmac12
import base64 as _b6412
import time as _time12
import secrets as _sec12
from pathlib import Path as _Path12

_AUTH_DB = _Path12(ROOT) / "config" / "studio_users.db"
_AUTH_DB.parent.mkdir(parents=True, exist_ok=True)
_AUTH_SECRET_FILE = _Path12(ROOT) / "config" / ".auth_secret"

# Generate/load secret for HMAC token signing
def _load_auth_secret():
    if _AUTH_SECRET_FILE.exists():
        try:
            return _AUTH_SECRET_FILE.read_bytes()
        except Exception:
            pass
    secret = _sec12.token_bytes(32)
    _AUTH_SECRET_FILE.write_bytes(secret)
    try:
        import os as _os_sec
        _os_sec.chmod(str(_AUTH_SECRET_FILE), 0o600)
    except Exception:
        pass
    return secret

_AUTH_SECRET = _load_auth_secret()

def _auth_db_init():
    conn = _sql12.connect(str(_AUTH_DB))
    c = conn.cursor()
    c.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT UNIQUE NOT NULL,
            name TEXT NOT NULL,
            password_hash TEXT NOT NULL,
            role TEXT NOT NULL DEFAULT 'user',
            active INTEGER NOT NULL DEFAULT 1,
            quota_videos INTEGER NOT NULL DEFAULT 50,
            videos_used INTEGER NOT NULL DEFAULT 0,
            created_at TEXT NOT NULL,
            last_login TEXT
        )
    """)
    c.execute("""
        CREATE TABLE IF NOT EXISTS videos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            name TEXT NOT NULL,
            size_mb REAL,
            created_at TEXT NOT NULL,
            FOREIGN KEY (user_id) REFERENCES users(id)
        )
    """)
    conn.commit()
    # Seed default admin
    c.execute("SELECT id FROM users WHERE email = ?", ("founder@asgtechsolutions.com",))
    if not c.fetchone():
        pw_hash = _hash_pw("changeme123")
        c.execute("""
            INSERT INTO users (email, name, password_hash, role, quota_videos, created_at)
            VALUES (?, ?, ?, ?, ?, ?)
        """, ("founder@asgtechsolutions.com", "Royal Murshad", pw_hash, "admin", 9999, _dt_stx.now().isoformat()))
        conn.commit()
        print("[auth] Seeded default admin: founder@asgtechsolutions.com / changeme123")
    conn.close()

def _hash_pw(password):
    salt = _sec12.token_bytes(16)
    dk = _hash12.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, 100000)
    return _b6412.b64encode(salt).decode() + "$" + _b6412.b64encode(dk).decode()

def _check_pw(password, stored):
    try:
        salt_b64, hash_b64 = stored.split("$")
        salt = _b6412.b64decode(salt_b64)
        expected = _b6412.b64decode(hash_b64)
        dk = _hash12.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, 100000)
        return _hmac12.compare_digest(dk, expected)
    except Exception:
        return False

def _sign_token(user_id, email, role, ttl_hours=168):
    payload = {
        "uid": user_id, "email": email, "role": role,
        "exp": int(_time12.time()) + ttl_hours * 3600,
    }
    raw = _json_stx.dumps(payload, separators=(",", ":")).encode()
    b = _b6412.urlsafe_b64encode(raw).rstrip(b"=")
    sig = _hmac12.new(_AUTH_SECRET, b, _hash12.sha256).digest()
    s = _b6412.urlsafe_b64encode(sig).rstrip(b"=")
    return (b + b"." + s).decode()

def _verify_token(token):
    try:
        b64, sig_b64 = token.split(".")
        b = b64.encode()
        expected = _hmac12.new(_AUTH_SECRET, b, _hash12.sha256).digest()
        given = _b6412.urlsafe_b64decode(sig_b64 + "=" * (-len(sig_b64) % 4))
        if not _hmac12.compare_digest(expected, given):
            return None
        raw = _b6412.urlsafe_b64decode(b64 + "=" * (-len(b64) % 4))
        payload = _json_stx.loads(raw)
        if payload.get("exp", 0) < _time12.time():
            return None
        return payload
    except Exception:
        return None

_auth_db_init()

@app.post("/api/studio/auth/login")
async def studio_auth_login(request: _Req_studio):
    body = await request.json()
    email = (body.get("email") or "").strip().lower()
    password = body.get("password") or ""
    if not email or not password:
        return {"ok": False, "error": "email and password required"}
    conn = _sql12.connect(str(_AUTH_DB))
    conn.row_factory = _sql12.Row
    c = conn.cursor()
    c.execute("SELECT * FROM users WHERE email = ?", (email,))
    row = c.fetchone()
    if not row or not row["active"]:
        conn.close()
        return {"ok": False, "error": "invalid credentials"}
    if not _check_pw(password, row["password_hash"]):
        conn.close()
        return {"ok": False, "error": "invalid credentials"}
    c.execute("UPDATE users SET last_login = ? WHERE id = ?", (_dt_stx.now().isoformat(), row["id"]))
    conn.commit()
    conn.close()
    token = _sign_token(row["id"], row["email"], row["role"])
    return {"ok": True, "token": token, "user": {
        "id": row["id"], "email": row["email"], "name": row["name"],
        "role": row["role"], "quota_videos": row["quota_videos"],
        "videos_used": row["videos_used"],
    }}

