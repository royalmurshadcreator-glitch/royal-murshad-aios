@app.get("/api/siteforge/projects/{pid}/export.zip")
def _sfsp_export_zip(pid: str):
    import io, zipfile
    from fastapi.responses import StreamingResponse
    d = _dragon_load_json("siteforge_store.json", {"projects": []})
    proj = next((p for p in d.get("projects", []) if p.get("id") == pid), None)
    if not proj:
        return {"ok": False, "error": "not found"}
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("index.html", proj.get("export_html", proj.get("preview_html", "")))
        z.writestr("README.txt", f"Generated by ASG SiteForge\nProject: {proj.get('name')}\nID: {proj.get('id')}\n")
    buf.seek(0)
    return StreamingResponse(buf, media_type="application/zip",
                             headers={"Content-Disposition": f"attachment; filename={proj.get('name','site')}.zip"})

