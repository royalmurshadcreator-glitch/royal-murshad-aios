import socket as _socket
import time as _time

def _tcp_latency(host: str, port: int, timeout: float = 1.0):
    """Measure TCP connect latency. Returns ms or None if unreachable."""
    try:
        t0 = _time.perf_counter()
        with _socket.create_connection((host, port), timeout=timeout):
            return round((_time.perf_counter() - t0) * 1000, 1)
    except Exception:
        return None

def _get_hostname():
    try:
        return _socket.gethostname()
    except Exception:
        return "unknown"

def _get_local_ip():
    try:
        s = _socket.socket(_socket.AF_INET, _socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return None

