from fastapi import WebSocket as _WS_audit, WebSocketDisconnect as _WSD_audit
import asyncio as _asyncio_ws

_WS_CLIENTS = set()

def _ws_last_master_line() -> str:
    """Return the last line of master file (or empty)."""
    if not _AUDIT_AVAILABLE:
        return ""
    m = _audit.MASTER_FILE
    if not m.exists():
        return ""
    try:
        with m.open("rb") as f:
            f.seek(0, 2)
            size = f.tell()
            if size == 0:
                return ""
            read_size = min(16384, size)
            f.seek(size - read_size)
            data = f.read().decode("utf-8", errors="ignore")
            lines = [l for l in data.splitlines() if l.strip()]
            return lines[-1] if lines else ""
    except Exception:
        return ""

def _ws_count_lines() -> int:
    if not _AUDIT_AVAILABLE:
        return 0
    m = _audit.MASTER_FILE
    if not m.exists():
        return 0
    try:
        with m.open("rb") as f:
            return sum(1 for _ in f)
    except Exception:
        return 0

@app.websocket("/ws/audit")
async def ws_audit_stream(ws: _WS_audit):
    await ws.accept()
    _WS_CLIENTS.add(ws)
    try:
        last_line = _ws_last_master_line()
        last_count = _ws_count_lines()
        # Send initial hello
        await ws.send_json({
            "kind": "hello",
            "total": last_count,
            "message": "connected to audit stream",
        })
        while True:
            await _asyncio_ws.sleep(1.0)
            # Check for new lines
            cur_count = _ws_count_lines()
            if cur_count > last_count:
                # Read all new lines from master
                new_lines = []
                try:
                    m = _audit.MASTER_FILE
                    with m.open("r", encoding="utf-8", errors="ignore") as f:
                        lines = f.readlines()
                    new_lines = lines[last_count:cur_count]
                except Exception:
                    pass
                for raw in new_lines:
                    try:
                        evt = _json_stx.loads(raw.strip())
                        await ws.send_json({"kind": "event", "event": evt})
                    except Exception:
                        continue
                last_count = cur_count
                last_line = _ws_last_master_line()
            # Heartbeat every 15s
            if cur_count == last_count:
                await ws.send_json({"kind": "ping", "total": cur_count})
    except _WSD_audit:
        pass
    except Exception as e:
        try:
            await ws.send_json({"kind": "error", "message": str(e)})
        except Exception:
            pass
    finally:
        _WS_CLIENTS.discard(ws)

