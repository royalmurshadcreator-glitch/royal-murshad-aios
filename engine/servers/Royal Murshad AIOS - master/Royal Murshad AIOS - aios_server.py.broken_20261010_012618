_ALERT_CFG = _Path_stx(ROOT) / "config" / "audit_alerts.json"
_ALERT_LOG = _Path_stx(ROOT) / "Logs" / "audit_alerts.jsonl"
_ALERT_LOG.parent.mkdir(parents=True, exist_ok=True)

_DEFAULT_RULES = [
    {"id": "errors_5m",  "enabled": True, "kind": "error_count",     "threshold": 5,  "window_min": 5,  "channels": ["log", "toast"]},
    {"id": "burst_5m",   "enabled": True, "kind": "burst",           "threshold": 30, "window_min": 5,  "channels": ["log", "toast"]},
    {"id": "blocked_any","enabled": True, "kind": "blocked_event",   "threshold": 1,  "window_min": 60, "channels": ["log", "toast"]},
    {"id": "new_actor",  "enabled": True, "kind": "new_actor",       "threshold": 1,  "window_min": 60, "channels": ["log"]},
]

def _alerts_load():
    try:
        if _ALERT_CFG.exists():
            data = _json_stx.loads(_ALERT_CFG.read_text(encoding="utf-8"))
            if "rules" in data:
                return data
    except Exception:
        pass
    return {"rules": _DEFAULT_RULES, "created_at": _dt5.utcnow().isoformat()}

def _alerts_save(cfg):
    _ALERT_CFG.parent.mkdir(parents=True, exist_ok=True)
    _ALERT_CFG.write_text(_json_stx.dumps(cfg, indent=2), encoding="utf-8")

def _alert_append(alert):
    """Append alert record to log."""
    try:
        with _ALERT_LOG.open("a", encoding="utf-8") as f:
            f.write(_json_stx.dumps(alert, default=str) + "\n")
    except Exception:
        pass

def _alert_evaluate():
    """Run all enabled rules against recent events. Return new alerts."""
    if not _AUDIT_AVAILABLE:
        return []
    cfg = _alerts_load()
    rules = [r for r in cfg.get("rules", []) if r.get("enabled", True)]
    if not rules:
        return []
    try:
        events = _audit.read_master(limit=5000)
        events.reverse()
    except Exception:
        return []

    now = _dt5.utcnow()
    new_alerts = []

    for rule in rules:
        kind = rule.get("kind")
        threshold = int(rule.get("threshold", 1))
        window_min = int(rule.get("window_min", 5))
        cutoff = (now - _td5(minutes=window_min)).isoformat()
        in_window = [e for e in events if (e.get("ts") or "") >= cutoff]

        triggered = False
        detail = ""

        if kind == "error_count":
            errors = [e for e in in_window if (e.get("severity") or "") in ("error", "critical")]
            if len(errors) >= threshold:
                triggered = True
                detail = str(len(errors)) + " error/critical events in last " + str(window_min) + " min"

        elif kind == "burst":
            slots = {}
            for e in in_window:
                try:
                    dt = _dt5.fromisoformat((e.get("ts") or "").replace("Z", "+00:00")).replace(tzinfo=None)
                    slot = int(dt.timestamp()) // 60
                    slots[slot] = slots.get(slot, 0) + 1
                except Exception:
                    continue
            peak = max(slots.values()) if slots else 0
            if peak >= threshold:
                triggered = True
                detail = str(peak) + " events in 1 minute (threshold " + str(threshold) + ")"

        elif kind == "blocked_event":
            blocked = [e for e in in_window if (e.get("result") or "") == "blocked"]
            if len(blocked) >= threshold:
                triggered = True
                detail = str(len(blocked)) + " blocked event(s) in last " + str(window_min) + " min"

        elif kind == "new_actor":
            seen_ids = set()
            for e in events:
                if (e.get("ts") or "") < cutoff:
                    seen_ids.add((e.get("actor") or {}).get("id") or "unknown")
            new_actors = set()
            for e in in_window:
                aid = (e.get("actor") or {}).get("id") or "unknown"
                if aid not in seen_ids:
                    new_actors.add(aid)
            if len(new_actors) >= threshold:
                triggered = True
                detail = str(len(new_actors)) + " new actor(s) in last " + str(window_min) + " min: " + ", ".join(list(new_actors)[:3])

        if triggered:
            alert = {
                "id": "alert_" + _dt5.utcnow().strftime("%Y%m%d_%H%M%S_") + rule.get("id", "rule"),
                "ts": _dt5.utcnow().isoformat(),
                "rule_id": rule.get("id"),
                "kind": kind,
                "severity": "error" if kind in ("error_count", "blocked_event") else "warn",
                "title": {
                    "error_count": "Error threshold breached",
                    "burst": "Event burst detected",
                    "blocked_event": "Blocked action occurred",
                    "new_actor": "New actor detected",
                }.get(kind, "Alert"),
                "detail": detail,
                "channels": rule.get("channels", ["log"]),
            }
            new_alerts.append(alert)

    return new_alerts

