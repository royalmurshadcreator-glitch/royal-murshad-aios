            return _json_stx.loads(_STUDIO_CFG.read_text(encoding="utf-8-sig"))
    except Exception:
        pass
    return {}

def _save_studio_cfg(cfg):
    _STUDIO_CFG.parent.mkdir(parents=True, exist_ok=True)
    _STUDIO_CFG.write_text(_json_stx.dumps(cfg, indent=2), encoding="utf-8")

def _get_keys_list():
    """Migrate + return list of keys."""
    cfg = _load_studio_cfg()
    keys = cfg.get("agnes_api_keys")
    if not keys:
        old = (cfg.get("agnes_api_key") or "").strip()
        if old:
            keys = [{"id": "agnes_primary", "label": "Agnes Primary", "key": old, "status": "ready", "last_used": None}]
            cfg["agnes_api_keys"] = keys
            cfg.pop("agnes_api_key", None)
            _save_studio_cfg(cfg)
        else:
            keys = []
    return keys

def _mask(k):
    if not k or len(k) < 12:
        return "(not set)"
    return k[:4] + ("*" * 20) + k[-4:]

