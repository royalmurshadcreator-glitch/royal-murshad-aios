_EYE_READER_PROC = None
_EYE_READER_STARTED = None
_EYE_READER_SCRIPT = _EyePath(r"D:\\AIOS\\05_MODELS\\aios_vision\eye_brain_reader.py")
_EYE_READER_PY = _EyePath(r"D:\\AIOS\\18_ENV\\\.venv\\Scripts\\python\.exe")


@app.post("/api/vision/eye/start")
def eye_reader_start():
    """Spawn eye_brain_reader.py in background."""
    global _EYE_READER_PROC, _EYE_READER_STARTED
    if _EYE_READER_PROC is not None and _EYE_READER_PROC.poll() is None:
        return {"ok": True, "message": "already running", "pid": _EYE_READER_PROC.pid}

    if not _EYE_READER_SCRIPT.exists():
        return {"ok": False, "error": "script not found: %s" % _EYE_READER_SCRIPT}
    if not _EYE_READER_PY.exists():
        return {"ok": False, "error": "python not found: %s" % _EYE_READER_PY}

    try:
        _EYE_READER_PROC = _eye_sp.Popen(
            [str(_EYE_READER_PY), str(_EYE_READER_SCRIPT)],
            cwd=str(_EyePath(r"D:\\AIOS")),
            creationflags=getattr(_eye_sp, "CREATE_NEW_CONSOLE", 0),
        )
        _EYE_READER_STARTED = _eye_t.time()
        return {"ok": True, "message": "started", "pid": _EYE_READER_PROC.pid}
    except Exception as e:
        return {"ok": False, "error": str(e)}


@app.post("/api/vision/eye/stop")
def eye_reader_stop():
    """Stop eye reader process."""
    global _EYE_READER_PROC, _EYE_READER_STARTED
    if _EYE_READER_PROC is None:
        # try to find orphan by process name
        try:
            import psutil as _ps
            killed = 0
            for p in _ps.process_iter(["pid", "name", "cmdline"]):
                try:
                    cl = p.info.get("cmdline") or []
                    if any("eye_brain_reader.py" in str(c) for c in cl):
                        p.kill()
                        killed += 1
                except Exception:
                    continue
            if killed:
                _EYE_READER_PROC = None
                _EYE_READER_STARTED = None
                return {"ok": True, "message": "killed %d orphan(s)" % killed}
        except Exception:
            pass
        return {"ok": True, "message": "not running"}

    try:
        _EYE_READER_PROC.terminate()
        try:
            _EYE_READER_PROC.wait(timeout=3)
        except Exception:
            _EYE_READER_PROC.kill()
        pid = _EYE_READER_PROC.pid
        _EYE_READER_PROC = None
        _EYE_READER_STARTED = None
        return {"ok": True, "message": "stopped", "pid": pid}
    except Exception as e:
        return {"ok": False, "error": str(e)}


@app.get("/api/vision/eye/reader-status")
def eye_reader_status():
    """Report running state, PID, uptime."""
    global _EYE_READER_PROC, _EYE_READER_STARTED
    running = _EYE_READER_PROC is not None and _EYE_READER_PROC.poll() is None
    uptime = None
    if running and _EYE_READER_STARTED:
        uptime = round(_eye_t.time() - _EYE_READER_STARTED, 1)
    return {
        "ok": True,
        "running": running,
        "pid": _EYE_READER_PROC.pid if running else None,
        "uptime_seconds": uptime,
        "script": str(_EYE_READER_SCRIPT),
        "python": str(_EYE_READER_PY),
    }

