@app.get("/api/audit/correlations")
async def audit_correlations(limit: int = 100, hours: int = 168):
    """List correlation groups (job lifecycles)."""
    if not _AUDIT_AVAILABLE:
        return {"ok": False, "error": "audit module not available"}
    try:
        events = _audit.read_all(limit=100000)
    except Exception as e:
        return {"ok": False, "error": str(e)}

    now = _dt5.utcnow()
    window_start = (now - _td5(hours=hours)).isoformat()

    groups = {}
    orphans = 0
    auto_group_count = 0
    for e in events:
        ts = e.get("ts") or ""
        if not ts or ts < window_start:
            continue
        cid = e.get("correlation_id") or ""
        if not cid:
            # AUTO-GROUP fallback: (actor_id + 5-min time slot)
            actor_id = (e.get("actor") or {}).get("id") or "unknown"
            try:
                dt = _dt5.fromisoformat(ts.replace("Z", "+00:00")).replace(tzinfo=None)
                slot = int(dt.timestamp()) // 300  # 5-min slots
                cid = "auto_" + actor_id + "_" + str(slot)
                auto_group_count += 1
            except Exception:
                orphans += 1
                continue
        if cid not in groups:
            groups[cid] = {
                "correlation_id": cid,
                "count": 0,
                "first_seen": ts,
                "last_seen": ts,
                "actors": set(),
                "categories": set(),
                "actions": set(),
                "severity_max": "info",
            }
        g = groups[cid]
        g["count"] += 1
        if ts < g["first_seen"]:
            g["first_seen"] = ts
        if ts > g["last_seen"]:
            g["last_seen"] = ts
        actor = (e.get("actor") or {}).get("name") or "unknown"
        g["actors"].add(actor)
        g["categories"].add(e.get("category") or "unknown")
        g["actions"].add(e.get("action") or "unknown")
        sev = e.get("severity") or "info"
        order = {"info": 0, "warn": 1, "error": 2, "critical": 3}
        if order.get(sev, 0) > order.get(g["severity_max"], 0):
            g["severity_max"] = sev

    # Finalize
    out = []
    for cid, g in groups.items():
        # Compute duration
        try:
            first_dt = _dt5.fromisoformat(g["first_seen"].replace("Z", "+00:00")).replace(tzinfo=None)
            last_dt = _dt5.fromisoformat(g["last_seen"].replace("Z", "+00:00")).replace(tzinfo=None)
            duration_sec = int((last_dt - first_dt).total_seconds())
        except Exception:
            duration_sec = 0
        out.append({
            "correlation_id": cid,
            "count": g["count"],
            "first_seen": g["first_seen"],
            "last_seen": g["last_seen"],
            "duration_sec": duration_sec,
            "actors": sorted(list(g["actors"])),
            "categories": sorted(list(g["categories"])),
            "action_count": len(g["actions"]),
            "severity_max": g["severity_max"],
        })

    out.sort(key=lambda x: x["last_seen"], reverse=True)

    return {
        "ok": True,
        "hours": hours,
        "orphans": orphans,
        "auto_grouped": auto_group_count,
        "group_count": len(out),
        "returned": min(limit, len(out)),
        "groups": out[:limit],
    }


@app.get("/api/audit/correlations/{correlation_id}")
async def audit_correlation_detail(correlation_id: str):
    """Full ordered event timeline for one correlation group."""
    if not _AUDIT_AVAILABLE:
        return {"ok": False, "error": "audit module not available"}
    try:
        events = _audit.read_all(limit=100000)
    except Exception as e:
        return {"ok": False, "error": str(e)}

    matched = []
    is_auto = correlation_id.startswith("auto_")

    # Parse auto group: auto_<actor_id>_<slot>
    auto_actor = None
    auto_slot = None
    if is_auto:
        try:
            # Remove prefix and split by last underscore
            rest = correlation_id[len("auto_"):]
            last_us = rest.rfind("_")
            auto_actor = rest[:last_us]
            auto_slot = int(rest[last_us+1:])
        except Exception:
            return {"ok": False, "error": "invalid auto group id"}

    for e in events:
        cid = e.get("correlation_id") or ""
        if is_auto:
            # Match by actor + 5-min slot
            actor_id = (e.get("actor") or {}).get("id") or "unknown"
            if actor_id != auto_actor:
                continue
            ts = e.get("ts") or ""
            try:
                dt = _dt5.fromisoformat(ts.replace("Z", "+00:00")).replace(tzinfo=None)
                slot = int(dt.timestamp()) // 300
                if slot == auto_slot:
                    matched.append(e)
            except Exception:
                continue
        else:
            if cid == correlation_id:
                matched.append(e)

    matched.sort(key=lambda x: str(x.get("ts") or ""))

    if not matched:
        return {"ok": False, "error": "correlation not found"}

    # Compute summary
    first_ts = matched[0].get("ts", "")
    last_ts = matched[-1].get("ts", "")
    try:
        first_dt = _dt5.fromisoformat(first_ts.replace("Z", "+00:00")).replace(tzinfo=None)
        last_dt = _dt5.fromisoformat(last_ts.replace("Z", "+00:00")).replace(tzinfo=None)
        duration_sec = int((last_dt - first_dt).total_seconds())
    except Exception:
        duration_sec = 0

    actors = set()
    categories = set()
    for e in matched:
        actors.add((e.get("actor") or {}).get("name") or "unknown")
        categories.add(e.get("category") or "unknown")

    # Simplify each event for the timeline
    timeline = []
    for e in matched:
        timeline.append({
            "id": e.get("id"),
            "ts": e.get("ts"),
            "type": e.get("type"),
            "category": e.get("category"),
            "severity": e.get("severity"),
            "actor": e.get("actor"),
            "action": e.get("action"),
            "resource": e.get("resource"),
            "result": e.get("result"),
            "message": e.get("message"),
            "source_file": e.get("source_file"),
            "payload": e.get("payload") if isinstance(e.get("payload"), dict) else None,
        })

    return {
        "ok": True,
        "correlation_id": correlation_id,
        "count": len(matched),
        "first_seen": first_ts,
        "last_seen": last_ts,
        "duration_sec": duration_sec,
        "actors": sorted(list(actors)),
        "categories": sorted(list(categories)),
        "timeline": timeline,
    }
