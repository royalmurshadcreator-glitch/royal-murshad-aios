def _w5_stats(name):
    def h():
        d = _w5_load(name)
        r = {"ok": True, "total": 0}
        for c in _W5_APPS[name]["collections"]:
            r[c] = len(d.get(c, []))
            r["total"] += r[c]
        return r
    return h

def _w5_list(name, col):
    def h():
        d = _w5_load(name)
        return {"ok": True, "items": d.get(col, []), "total": len(d.get(col, []))}
    return h

def _w5_add(name, col):
    def h(body: dict = {}):
        d = _w5_load(name)
        if col not in d: d[col] = []
        iid = uuid.uuid4().hex[:8]
        item = {"id": iid, "created": _w5_now()}
        for k, v in (body or {}).items():
            item[k] = v
        d[col].append(item)
        _w5_save(name, d)
        return {"ok": True, "id": iid, "item": item}
    return h

def _w5_del(name, col):
    def h(item_id: str):
        d = _w5_load(name)
        before = len(d.get(col, []))
        d[col] = [x for x in d.get(col, []) if x.get("id") != item_id]
        _w5_save(name, d)
        return {"ok": True, "removed": before - len(d.get(col, []))}
    return h

_existing_paths = set()
for r in app.routes:
    p = getattr(r, "path", None)
    if p: _existing_paths.add(p)

for _name, _cfg in _W5_APPS.items():
    # Use distinct stats path to avoid collisions
    stats_path = f"/api/{_name}/wave-stats"
    if stats_path not in _existing_paths:
        app.add_api_route(stats_path, _w5_stats(_name), methods=["GET"])
        _existing_paths.add(stats_path)
    for _col in _cfg["collections"]:
        list_path = f"/api/{_name}/{_col}"
        del_path = f"/api/{_name}/{_col}/{{item_id}}"
        if list_path not in _existing_paths:
            app.add_api_route(list_path, _w5_list(_name, _col), methods=["GET"])
            app.add_api_route(list_path, _w5_add(_name, _col), methods=["POST"])
            _existing_paths.add(list_path)
        if del_path not in _existing_paths:
            app.add_api_route(del_path, _w5_del(_name, _col), methods=["DELETE"])
