import subprocess as _sp9r
import time as _t9r

_GUARD_BLOCKED = [
    "format ", "diskpart", "regedit", "shutdown", "reboot",
    "rm -rf", "del /f", "del /q", "rmdir /s", "reg delete",
    "remove-item -recurse", "stop-computer", "restart-computer",
    "bcdedit", "cipher /w", "vssadmin", "wbadmin", "net user",
    "takeown", "icacls", "schtasks /delete", "wevtutil cl",
]

def _guard_check(cmd: str) -> tuple:
    """Return (allowed, reason). Simple mimic of Guard policy."""
    cmd_lower = (cmd or "").lower()
    for kw in _GUARD_BLOCKED:
        if kw in cmd_lower:
            return False, "blocked keyword: " + kw
    # blocked paths
    for bad in [".env", ".ssh", "passwords", "credentials", "keys.json",
                "id_rsa", ".aws", ".kube", "secrets"]:
        if bad in cmd_lower:
            return False, "blocked path: " + bad
    return True, "ok"


