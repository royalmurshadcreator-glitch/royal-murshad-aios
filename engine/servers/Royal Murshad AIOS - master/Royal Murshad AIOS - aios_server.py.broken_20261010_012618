@app.get("/api/audit/actors/behaviour-drift")
async def audit_behaviour_drift(days: int = 7):
    """Compare each actor's activity today vs the prior N days baseline."""
    if not _AUDIT_AVAILABLE:
        return {"ok": False, "error": "audit module not available"}
    try:
        events = _audit.read_all(limit=100000)
    except Exception as e:
        return {"ok": False, "error": str(e)}

    now = _dt5.utcnow()
    today_start = now.replace(hour=0, minute=0, second=0, microsecond=0)
    baseline_start = today_start - _td5(days=days)

    today_counts = {}
    baseline_counts = {}

    for e in events:
        ts = e.get("ts") or ""
        if not ts:
            continue
        try:
            evt_dt = _dt5.fromisoformat(ts.replace("Z", "+00:00")).replace(tzinfo=None)
        except Exception:
            continue
        actor = (e.get("actor") or {}).get("id") or "unknown"
        if evt_dt >= today_start:
            today_counts[actor] = today_counts.get(actor, 0) + 1
        elif evt_dt >= baseline_start:
            baseline_counts[actor] = baseline_counts.get(actor, 0) + 1

    # Compute drift per actor
    all_actors = set(today_counts.keys()) | set(baseline_counts.keys())
    drifts = []
    for aid in all_actors:
        today = today_counts.get(aid, 0)
        baseline_total = baseline_counts.get(aid, 0)
        baseline_avg = baseline_total / max(1, days)
        if baseline_avg == 0 and today > 0:
            drift_pct = 100.0
        elif baseline_avg > 0:
            drift_pct = round(((today - baseline_avg) / baseline_avg) * 100.0, 1)
        else:
            drift_pct = 0.0
        drifts.append({
            "actor_id": aid,
            "today": today,
            "baseline_avg": round(baseline_avg, 1),
            "drift_pct": drift_pct,
        })

    drifts.sort(key=lambda x: -abs(x["drift_pct"]))
    return {
        "ok": True,
        "days": days,
        "drifts": drifts,
    }
