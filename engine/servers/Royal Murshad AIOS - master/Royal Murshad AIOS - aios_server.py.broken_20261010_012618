import sqlite3 as _wt_sqlite3
import os as _wt_os

_WT_DB = r"D:\AIOS\08_DATA\watchtower.db"


def _wt_read_db():
    if not _wt_os.path.isfile(_WT_DB):
        return None
    conn = _wt_sqlite3.connect(f"file:{_WT_DB}?mode=ro", uri=True)
    conn.row_factory = _wt_sqlite3.Row
    return conn


@app.get("/api/watchtower/status")
def _wt_status():
    conn = _wt_read_db()
    if conn is None:
        return {"ok": False, "error": "watchtower.db not found"}
    last = conn.execute("SELECT * FROM scans ORDER BY id DESC LIMIT 1").fetchone()
    total_files = conn.execute("SELECT COUNT(*) FROM files WHERE deleted_at_scan IS NULL").fetchone()[0]
    total_bytes = conn.execute("SELECT COALESCE(SUM(size_bytes),0) FROM files WHERE deleted_at_scan IS NULL").fetchone()[0]
    by_status = {}
    for r in conn.execute("SELECT status, COUNT(*), COALESCE(SUM(size_bytes),0) FROM files WHERE deleted_at_scan IS NULL GROUP BY status"):
        by_status[r[0] or "unknown"] = {"files": r[1], "bytes": r[2]}
    conn.close()
    return {
        "ok": True,
        "last_scan_id": last["id"] if last else None,
        "last_scan_at": last["started_at"] if last else None,
        "duration_sec": last["duration_sec"] if last else None,
        "totals": {"files": total_files, "bytes": total_bytes},
        "by_status": by_status,
    }


@app.get("/api/watchtower/changes")
def _wt_changes(since_scan_id: int = 0, limit: int = 100):
    conn = _wt_read_db()
    if conn is None:
        return {"ok": False, "error": "watchtower.db not found"}
    rows = conn.execute(
        "SELECT scan_id, event_type, path_before, path_after, size_before, size_after, confidence, detected_at "
        "FROM events WHERE scan_id > ? ORDER BY id DESC LIMIT ?",
        (since_scan_id, limit),
    ).fetchall()
    conn.close()
    return {"ok": True, "count": len(rows), "events": [dict(r) for r in rows]}


@app.get("/api/watchtower/find")
def _wt_find(name: str, limit: int = 20):
    conn = _wt_read_db()
    if conn is None:
        return {"ok": False, "error": "watchtower.db not found"}
    like = "%" + name.lower() + "%"
    rows = conn.execute(
        "SELECT path, size_bytes, mtime, status FROM files "
        "WHERE lower(path) LIKE ? AND deleted_at_scan IS NULL "
        "ORDER BY size_bytes DESC LIMIT ?",
        (like, limit),
    ).fetchall()
    conn.close()
    return {"ok": True, "count": len(rows), "matches": [dict(r) for r in rows]}


@app.get("/api/watchtower/top")
def _wt_top(drive: str = None, limit: int = 20):
    conn = _wt_read_db()
    if conn is None:
        return {"ok": False, "error": "watchtower.db not found"}
    if drive:
        rows = conn.execute(
            "SELECT folder, COUNT(*) AS n, COALESCE(SUM(size_bytes),0) AS s "
            "FROM files WHERE deleted_at_scan IS NULL AND folder IS NOT NULL "
            "AND drive = ? GROUP BY folder ORDER BY s DESC LIMIT ?",
            (drive.upper(), limit),
        ).fetchall()
    else:
        rows = conn.execute(
            "SELECT folder, COUNT(*) AS n, COALESCE(SUM(size_bytes),0) AS s "
            "FROM files WHERE deleted_at_scan IS NULL AND folder IS NOT NULL "
            "GROUP BY folder ORDER BY s DESC LIMIT ?",
            (limit,),
        ).fetchall()
    conn.close()
    return {"ok": True, "count": len(rows), "folders": [dict(r) for r in rows]}


@app.get("/api/watchtower/dead")
def _wt_dead(limit: int = 30):
    conn = _wt_read_db()
    if conn is None:
        return {"ok": False, "error": "watchtower.db not found"}
    rows = conn.execute(
        "SELECT path, size_bytes, mtime FROM files "
        "WHERE status = 'dead' AND deleted_at_scan IS NULL "
        "ORDER BY size_bytes DESC LIMIT ?",
        (limit,),
    ).fetchall()
    total = conn.execute(
        "SELECT COUNT(*), COALESCE(SUM(size_bytes),0) FROM files "
        "WHERE status = 'dead' AND deleted_at_scan IS NULL"
    ).fetchone()
    conn.close()
    return {
        "ok": True,
        "total_files": total[0],
        "total_bytes": total[1],
        "showing": len(rows),
        "files": [dict(r) for r in rows],
    }


