@app.post("/api/audit/retention/run")
async def audit_retention_run(request: _Req_studio):
    """Archive + delete entries older than keep_days."""
    if not _AUDIT_AVAILABLE:
        return {"ok": False, "error": "audit module not available"}
    body = await request.json() if await request.body() else {}
    cfg = _retention_load()
    keep_days = int(body.get("keep_days", cfg.get("keep_days", 30)))
    dry_run = bool(body.get("dry_run", False))

    master = _audit.MASTER_FILE
    if not master.exists():
        return {"ok": False, "error": "master file not found"}

    cutoff_iso = (_dt5.utcnow() - _td5(days=keep_days)).isoformat()

    keep_lines = []
    archive_lines = []
    total = 0
    try:
        with master.open("r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if not line.strip():
                    continue
                total += 1
                try:
                    e = _json_stx.loads(line)
                except Exception:
                    keep_lines.append(line)
                    continue
                ts = e.get("ts") or ""
                if ts and ts < cutoff_iso:
                    archive_lines.append(line)
                else:
                    keep_lines.append(line)
    except Exception as ex:
        return {"ok": False, "error": str(ex)}

    archived_count = len(archive_lines)
    kept_count = len(keep_lines)
    deleted_count = archived_count

    if dry_run:
        return {
            "ok": True,
            "dry_run": True,
            "would_archive": archived_count,
            "would_keep": kept_count,
            "total_before": total,
            "cutoff_iso": cutoff_iso,
            "keep_days": keep_days,
        }

    # Archive to gz
    archive_path = None
    if archived_count > 0:
        ts_str = _dt5.utcnow().strftime("%Y%m%d_%H%M%S")
        archive_path = _RETENTION_ARCHIVE / ("audit_archive_" + ts_str + ".jsonl.gz")
        try:
            with _gz10.open(str(archive_path), "wt", encoding="utf-8") as gz:
                gz.writelines(archive_lines)
        except Exception as ex:
            return {"ok": False, "error": "archive failed: " + str(ex)}

    # Rewrite master (safe: write to temp, swap)
    try:
        tmp = master.with_suffix(".jsonl.tmp")
        with tmp.open("w", encoding="utf-8") as f:
            f.writelines(keep_lines)
        tmp.replace(master)
    except Exception as ex:
        return {"ok": False, "error": "rewrite failed: " + str(ex)}

    cfg["last_run"] = _dt5.utcnow().isoformat()
    cfg["last_archived_count"] = archived_count
    cfg["last_deleted_count"] = deleted_count
    cfg["keep_days"] = keep_days
    _retention_save(cfg)

    return {
        "ok": True,
        "total_before": total,
        "archived": archived_count,
        "kept": kept_count,
        "deleted": deleted_count,
        "archive_file": archive_path.name if archive_path else None,
        "cutoff_iso": cutoff_iso,
    }
