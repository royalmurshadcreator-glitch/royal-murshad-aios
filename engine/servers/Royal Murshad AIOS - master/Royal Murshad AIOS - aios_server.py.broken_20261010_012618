def _xlsx_escape(v):
    s = str(v) if v is not None else ""
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace(chr(34), "&quot;")

def _build_xlsx(rows, sheet_name="Audit"):
    buf = _io14.BytesIO()
    z = _zip14.ZipFile(buf, "w", _zip14.ZIP_DEFLATED)
    ct = chr(60) + "?xml version=" + chr(34) + "1.0" + chr(34) + " encoding=" + chr(34) + "UTF-8" + chr(34) + " standalone=" + chr(34) + "yes" + chr(34) + "?" + chr(62) + chr(10) + chr(60) + "Types xmlns=" + chr(34) + "http://schemas.openxmlformats.org/package/2006/content-types" + chr(34) + chr(62) + chr(10) + chr(60) + "Default Extension=" + chr(34) + "rels" + chr(34) + " ContentType=" + chr(34) + "application/vnd.openxmlformats-package.relationships+xml" + chr(34) + "/" + chr(62) + chr(10) + chr(60) + "Default Extension=" + chr(34) + "xml" + chr(34) + " ContentType=" + chr(34) + "application/xml" + chr(34) + "/" + chr(62) + chr(10) + chr(60) + "Override PartName=" + chr(34) + "/xl/workbook.xml" + chr(34) + " ContentType=" + chr(34) + "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml" + chr(34) + "/" + chr(62) + chr(10) + chr(60) + "Override PartName=" + chr(34) + "/xl/worksheets/sheet1.xml" + chr(34) + " ContentType=" + chr(34) + "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml" + chr(34) + "/" + chr(62) + chr(10) + chr(60) + "/Types" + chr(62)
    z.writestr("[Content_Types].xml", ct)
    rels = chr(60) + "?xml version=" + chr(34) + "1.0" + chr(34) + " encoding=" + chr(34) + "UTF-8" + chr(34) + " standalone=" + chr(34) + "yes" + chr(34) + "?" + chr(62) + chr(10) + chr(60) + "Relationships xmlns=" + chr(34) + "http://schemas.openxmlformats.org/package/2006/relationships" + chr(34) + chr(62) + chr(10) + chr(60) + "Relationship Id=" + chr(34) + "rId1" + chr(34) + " Type=" + chr(34) + "http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" + chr(34) + " Target=" + chr(34) + "xl/workbook.xml" + chr(34) + "/" + chr(62) + chr(10) + chr(60) + "/Relationships" + chr(62)
    z.writestr("_rels/.rels", rels)
    wb = chr(60) + "?xml version=" + chr(34) + "1.0" + chr(34) + " encoding=" + chr(34) + "UTF-8" + chr(34) + " standalone=" + chr(34) + "yes" + chr(34) + "?" + chr(62) + chr(10) + chr(60) + "workbook xmlns=" + chr(34) + "http://schemas.openxmlformats.org/spreadsheetml/2006/main" + chr(34) + chr(62) + chr(10) + chr(60) + "sheets" + chr(62) + chr(60) + "sheet name=" + chr(34) + _xlsx_escape(sheet_name) + chr(34) + " sheetId=" + chr(34) + "1" + chr(34) + "/" + chr(62) + chr(60) + "/sheets" + chr(62) + chr(10) + chr(60) + "/workbook" + chr(62)
    z.writestr("xl/workbook.xml", wb)
    wbrels = chr(60) + "?xml version=" + chr(34) + "1.0" + chr(34) + " encoding=" + chr(34) + "UTF-8" + chr(34) + " standalone=" + chr(34) + "yes" + chr(34) + "?" + chr(62) + chr(10) + chr(60) + "Relationships xmlns=" + chr(34) + "http://schemas.openxmlformats.org/package/2006/relationships" + chr(34) + chr(62) + chr(10) + chr(60) + "Relationship Id=" + chr(34) + "rId1" + chr(34) + " Type=" + chr(34) + "http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" + chr(34) + " Target=" + chr(34) + "worksheets/sheet1.xml" + chr(34) + "/" + chr(62) + chr(10) + chr(60) + "/Relationships" + chr(62)
    z.writestr("xl/_rels/workbook.xml.rels", wbrels)
    styles = chr(60) + "?xml version=" + chr(34) + "1.0" + chr(34) + " encoding=" + chr(34) + "UTF-8" + chr(34) + " standalone=" + chr(34) + "yes" + chr(34) + "?" + chr(62) + chr(10) + chr(60) + "styleSheet xmlns=" + chr(34) + "http://schemas.openxmlformats.org/spreadsheetml/2006/main" + chr(34) + chr(62) + chr(60) + "/styleSheet" + chr(62)
    z.writestr("xl/styles.xml", styles)
    rows_xml = []
    for ri, row in enumerate(rows):
        cells = []
        for ci, val in enumerate(row):
            col_letter = chr(ord("A") + ci) if ci < 26 else "A" + chr(ord("A") + (ci - 26))
            ref = col_letter + str(ri + 1)
            if isinstance(val, (int, float)) and not isinstance(val, bool):
                cells.append(chr(60) + "c r=" + chr(34) + ref + chr(34) + chr(62) + chr(60) + "v" + chr(62) + str(val) + chr(60) + "/v" + chr(62) + chr(60) + "/c" + chr(62))
            else:
                txt = _xlsx_escape(val)
                cells.append(chr(60) + "c r=" + chr(34) + ref + chr(34) + " t=" + chr(34) + "inlineStr" + chr(34) + chr(62) + chr(60) + "is" + chr(62) + chr(60) + "t" + chr(62) + txt + chr(60) + "/t" + chr(62) + chr(60) + "/is" + chr(62) + chr(60) + "/c" + chr(62))
        rows_xml.append(chr(60) + "row r=" + chr(34) + str(ri + 1) + chr(34) + chr(62) + "".join(cells) + chr(60) + "/row" + chr(62))
    sheet = chr(60) + "?xml version=" + chr(34) + "1.0" + chr(34) + " encoding=" + chr(34) + "UTF-8" + chr(34) + " standalone=" + chr(34) + "yes" + chr(34) + "?" + chr(62) + chr(10) + chr(60) + "worksheet xmlns=" + chr(34) + "http://schemas.openxmlformats.org/spreadsheetml/2006/main" + chr(34) + chr(62) + chr(60) + "sheetData" + chr(62) + "".join(rows_xml) + chr(60) + "/sheetData" + chr(62) + chr(60) + "/worksheet" + chr(62)
    z.writestr("xl/worksheets/sheet1.xml", sheet)
    z.close()
    return buf.getvalue()

