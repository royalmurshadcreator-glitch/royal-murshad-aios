        "by_severity": {"info": 0, "warn": 0, "error": 0, "critical": 0},
        "by_actor_kind": {"system": 0, "agent": 0, "user": 0},
    }
    for e in events:
        cat = e.get("category") or "unknown"
        summary["by_category"][cat] = summary["by_category"].get(cat, 0) + 1
        sev = e.get("severity") or "info"
        if sev in summary["by_severity"]:
            summary["by_severity"][sev] += 1
        ak = (e.get("actor") or {}).get("kind") or "system"
        if ak in summary["by_actor_kind"]:
            summary["by_actor_kind"][ak] += 1

    # Chain verify (sample)
    sample_chain = []
    for e in events[:50]:
        sample_chain.append({
            "id": e.get("id"),
            "ts": e.get("ts"),
            "category": e.get("category"),
            "severity": e.get("severity"),
            "action": e.get("action"),
            "result": e.get("result"),
            "hash": e.get("hash"),
            "prev_hash": e.get("prev_hash"),
            "actor": (e.get("actor") or {}).get("name"),
        })

    return {
        "ok": True,
        "share": {
            "label": share["label"],
            "standard": share["standard"],
            "created_at": share["created_at"],
            "expires_at": share["expires_at"],
        },
        "summary": summary,
