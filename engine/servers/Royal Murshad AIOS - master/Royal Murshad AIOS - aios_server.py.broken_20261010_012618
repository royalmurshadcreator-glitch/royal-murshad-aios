    if source:
        all_events = [e for e in all_events if e.get("source_file") == source]

    matched = [e for e in all_events if _dsl_match(e, parsed)]

    # Sort newest first by ts
    matched.sort(key=lambda x: str(x.get("ts") or ""), reverse=True)

    total = len(matched)
    return {
        "ok": True,
        "query": q,
        "parsed": parsed,
        "total": total,
        "returned": min(limit, total),
        "events": matched[:limit],
    }


