    body = await request.json()
    cat = (body.get("category") or "").strip().lower()
    data = (body.get("data_base64") or "").strip()
    filename = (body.get("filename") or "asset.bin").strip()

    if cat not in ("branding", "music", "presenters", "templates"):
        return {"ok": False, "error": "invalid category"}
    if not data:
        return {"ok": False, "error": "no data"}

    if data.startswith("data:"):
        try:
            data = data.split(",", 1)[1]
        except Exception:
            return {"ok": False, "error": "malformed data URL"}

    try:
        raw = _b64_assets.b64decode(data)
    except Exception as e:
        return {"ok": False, "error": "base64 decode failed: " + str(e)}

    if len(raw) < 50:
        return {"ok": False, "error": "file too small"}
    if len(raw) > 100 * 1024 * 1024:
