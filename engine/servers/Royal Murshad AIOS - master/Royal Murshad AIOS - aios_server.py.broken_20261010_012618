from fastapi.responses import Response as _Resp11

def _report_hash_chain_sample(events: list, max_entries: int = 100) -> list:
    """Extract a sample of events with their hash chain."""
    sample = []
    for e in events[:max_entries]:
        sample.append({
            "id": e.get("id"),
            "ts": e.get("ts"),
            "category": e.get("category"),
            "severity": e.get("severity"),
            "actor": e.get("actor"),
            "action": e.get("action"),
            "result": e.get("result"),
            "hash": e.get("hash"),
            "prev_hash": e.get("prev_hash"),
        })
    return sample

def _report_actor_summary(events: list) -> dict:
    by_kind = {"system": 0, "agent": 0, "user": 0}
    by_actor = {}
    for e in events:
        actor = e.get("actor") or {}
        kind = actor.get("kind") or "system"
        if kind in by_kind:
            by_kind[kind] += 1
        name = actor.get("name") or "unknown"
        by_actor[name] = by_actor.get(name, 0) + 1
    top = sorted(by_actor.items(), key=lambda kv: -kv[1])[:10]
    return {
        "by_kind": by_kind,
        "top_actors": [{"name": n, "count": c} for n, c in top],
        "distinct_actors": len(by_actor),
    }

def _report_severity_summary(events: list) -> dict:
    by_sev = {"info": 0, "warn": 0, "error": 0, "critical": 0}
    for e in events:
        sev = e.get("severity") or "info"
        if sev in by_sev:
            by_sev[sev] += 1
    return by_sev

def _report_category_summary(events: list) -> dict:
    by_cat = {}
    for e in events:
        cat = e.get("category") or "unknown"
        by_cat[cat] = by_cat.get(cat, 0) + 1
    return by_cat

def _report_chain_verify(events: list) -> dict:
    """Verify the chain integrity of the given events."""
    if not events:
        return {"intact": True, "verified": 0, "total": 0, "breaks": []}
    import hashlib as _h11
    breaks = []
    verified = 0
    prev = ""
    for idx, e in enumerate(events):
        if not e.get("hash"):
            prev = e.get("hash", "")
            continue
        clone = {k: v for k, v in e.items() if k not in ("hash", "prev_hash", "id")}
        canonical = _json_stx.dumps(clone, sort_keys=True, separators=(",", ":"), default=str)
        recomputed = _h11.sha256((prev + canonical).encode("utf-8")).hexdigest()
        if e.get("prev_hash") != prev:
            breaks.append({"index": idx, "reason": "prev mismatch", "id": e.get("id")})
        elif recomputed != e.get("hash"):
            breaks.append({"index": idx, "reason": "hash mismatch", "id": e.get("id")})
        else:
            verified += 1
        prev = e.get("hash", "")
    return {
        "intact": len(breaks) == 0,
        "verified": verified,
        "total": len([x for x in events if x.get("hash")]),
        "breaks": breaks[:20],
    }

