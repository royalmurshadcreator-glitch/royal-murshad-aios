# REAL NETWORK I/O (system-wide bytes sent/recv per second)
# ----------------------------------------------------------------------------
_net_prev = {"ts": 0.0, "sent": 0, "recv": 0}

@app.get("/api/system/network")
def system_network():
    """Real network throughput measured via psutil."""
    global _net_prev
    try:
        import psutil as _ps
        now = _time.time()
        counters = _ps.net_io_counters()
        sent = counters.bytes_sent
        recv = counters.bytes_recv
        if _net_prev["ts"] == 0.0:
            _net_prev = {"ts": now, "sent": sent, "recv": recv}
            return {
                "ok": True,
                "bytes_sent_per_sec": 0,
                "bytes_recv_per_sec": 0,
                "total_sent_mb": round(sent / (1024 * 1024), 2),
                "total_recv_mb": round(recv / (1024 * 1024), 2),
                "percent": 0,
            }
        dt = now - _net_prev["ts"]
        if dt <= 0:
            dt = 1.0
        sent_bps = (sent - _net_prev["sent"]) / dt
        recv_bps = (recv - _net_prev["recv"]) / dt
        # a loose "load %" against a 100 Mbps reference
        ref_bps = 100 * 1024 * 1024 / 8  # 100 Mbps in bytes/sec
        load_pct = min(100.0, max(sent_bps, recv_bps) / ref_bps * 100.0)
        _net_prev = {"ts": now, "sent": sent, "recv": recv}
        return {
            "ok": True,
            "bytes_sent_per_sec": int(sent_bps),
            "bytes_recv_per_sec": int(recv_bps),
            "sent_mbps": round(sent_bps * 8 / (1024 * 1024), 3),
            "recv_mbps": round(recv_bps * 8 / (1024 * 1024), 3),
            "total_sent_mb": round(sent / (1024 * 1024), 2),
            "total_recv_mb": round(recv / (1024 * 1024), 2),
            "percent": round(load_pct, 1),
        }
    except Exception as e:
        return {"ok": False, "error": str(e)}

def _startup_sweep_orphans():
    """Kill any orphan jarvis-vision-bridge processes left over from a prior backend session."""
    try:
        import psutil as _ps_boot
        killed = 0
        for _p in _ps_boot.process_iter(["pid", "name", "cmdline"]):
            try:
                if _p.info["name"] and "python" in _p.info["name"].lower():
                    _c = " ".join(_p.info["cmdline"] or [])
                    if "jarvis-vision-bridge" in _c:
                        _p.kill()
                        killed += 1
            except Exception:
                pass
        if killed:
            print("[startup] swept %d orphan vision bridge process(es)" % killed)
    except Exception as _e:
        print("[startup] orphan sweep skipped: %s" % _e)

_startup_sweep_orphans()



