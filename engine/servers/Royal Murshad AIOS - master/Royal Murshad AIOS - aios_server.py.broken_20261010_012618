def _sfsp_generate(prompt, template, name, fast):
    model = _MODEL_FAST if fast else _MODEL_CODE
    length_hint = "short clean HTML5, single file, inline CSS, ~80 lines" if fast else "polished HTML5, single file, inline CSS, hero+3 features+footer, ~150 lines"
    full_prompt = f"""You are a web designer. Generate {length_hint} for a {template} site named "{name}".
User description: {prompt or "A modern professional website"}
Rules:
- Output ONLY raw HTML, no markdown, no explanation.
- Use dark theme: background #0a0f1e, accent #00d4ff, text #e2e8f0.
- No external fonts, no external JS, no external CSS. Inline everything.
- Must be complete <!DOCTYPE html>...</html>."""
    try:
        r = requests.post(_OLLAMA + "/api/generate", json={
            "model": model, "prompt": full_prompt, "stream": False,
            "options": {"temperature": 0.7, "num_predict": 500 if not fast else 800}
        }, timeout=600)
        r.raise_for_status()
        out = r.json().get("response", "").strip()
        if out.startswith("```"):
            out = out.split("```")[1]
            if out.startswith("html"): out = out[4:]
        return out.strip() if out else _sfsp_fallback(name, template)
    except Exception as e:
        return _sfsp_fallback(name, template, str(e))

