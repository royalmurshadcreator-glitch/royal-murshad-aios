@app.post("/api/vision/start")
def vision_start():
    """Launches the vision bridge script as a background process."""
    global _VISION_PROC
    with _VISION_LOCK:
        if _VISION_PROC is not None and _VISION_PROC.poll() is None:
            return {"ok": True, "message": "already running", "pid": _VISION_PROC.pid}
        if not _VISION_SCRIPT.exists():
            return {"ok": False, "error": "script not found: %s" % _VISION_SCRIPT}
        try:
            # Sweep any orphan jarvis-vision-bridge processes before spawning a new one
            try:
                import psutil as _ps_sweep
                for _op in _ps_sweep.process_iter(["pid", "name", "cmdline"]):
                    try:
                        if _op.info["name"] and "python" in _op.info["name"].lower():
                            _cmd = " ".join(_op.info["cmdline"] or [])
                            if "jarvis-vision-bridge" in _cmd:
                                _op.kill()
                    except Exception:
                        pass
            except Exception:
                pass
            py = r"D:\\AIOS\\18_ENV\\\.venv\\Scripts\\python\.exe"
            _VISION_PROC = _subprocess.Popen(
                [py, str(_VISION_SCRIPT)],
                cwd=str(_VISION_ROOT),
            )
            return {"ok": True, "message": "started", "pid": _VISION_PROC.pid}
        except Exception as e:
            return {"ok": False, "error": str(e)}

@app.post("/api/vision/stop")
def vision_stop():
    """Stops the vision bridge and any orphan processes."""
    global _VISION_PROC
    with _VISION_LOCK:
        killed = 0
        try:
            import psutil as _ps
            for p in _ps.process_iter(["pid", "name", "cmdline"]):
                try:
                    if p.info["name"] and "python" in p.info["name"].lower():
                        cmdline = " ".join(p.info["cmdline"] or [])
                        if "jarvis-vision-bridge" in cmdline:
                            p.kill()
                            killed += 1
                except Exception:
                    pass
        except Exception:
            pass
        if _VISION_PROC is not None:
            try:
                _VISION_PROC.terminate()
                try:
                    _VISION_PROC.wait(timeout=3)
                except Exception:
                    _VISION_PROC.kill()
            except Exception:
                pass
            _VISION_PROC = None
        return {"ok": True, "message": "stopped %d process(es)" % killed}

