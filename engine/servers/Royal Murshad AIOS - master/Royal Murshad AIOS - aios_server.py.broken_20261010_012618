except Exception as _fuse_err:
    print(f"[fusion] failed to import: {_fuse_err}")
    _FUSION = None
    _FUSION_AVAILABLE = False


_FUSION_COOLDOWN = {}

def _fusion_ticker():
    """Every 2s: fuse eye data -> classify -> fire feeling events."""
    import time as _t
    while True:
        try:
            _t.sleep(2.0)
            if not _FUSION_AVAILABLE or _FUSION is None:
                continue
            if not _FEELING_AVAILABLE or _FEELING is None:
                continue
            result = _FUSION.classify_live()
            now_t = _t.time()
            for ev in result.get("events", []):
                last = _FUSION_COOLDOWN.get(ev, 0)
                if now_t - last >= 30.0:
                    _FUSION_COOLDOWN[ev] = now_t
                    _FEELING.trigger(ev)
        except Exception:
            pass


if _FUSION_AVAILABLE and _FEELING_AVAILABLE:
    _fusion_thread = _feel_threading.Thread(target=_fusion_ticker, daemon=True)
    _fusion_thread.start()
    print("[fusion] engine online, ticker running")
