import re as _re_q

def _dsl_parse(query: str) -> dict:
    """Parse simple query DSL: type:error AND actor:foo AND severity:warn."""
    out = {"filters": {}, "text": ""}
    if not query:
        return out
    q = query.strip()
    parts = _re_q.split(r"\s+AND\s+|\s*,\s*", q, flags=_re_q.IGNORECASE)
    for part in parts:
        part = part.strip()
        if not part:
            continue
        m = _re_q.match(r"^(\w+)\s*:\s*(.+)$", part)
        if m:
            key = m.group(1).lower()
            val = m.group(2).strip().strip('"').strip("'")
            if key in ("type", "category", "severity", "actor", "action",
                       "resource", "result", "source", "source_file"):
                out["filters"][key] = val
            elif key == "id":
                out["filters"]["id"] = val
            elif key == "since":
                out["filters"]["since"] = val
            elif key == "until":
                out["filters"]["until"] = val
            else:
                out["text"] += (" " + part)
        elif part.startswith("!"):
            out["filters"]["exclude"] = out["filters"].get("exclude", "") + "," + part[1:]
        else:
            out["text"] += (" " + part)
    out["text"] = out["text"].strip().lower()
    return out


def _dsl_match(evt: dict, parsed: dict) -> bool:
    """Return True if event matches parsed DSL."""
    f = parsed["filters"]
    # direct field filters
    if "type" in f and (evt.get("type") or "").lower() != f["type"].lower():
        return False
    if "category" in f and (evt.get("category") or "").lower() != f["category"].lower():
        return False
    if "severity" in f and (evt.get("severity") or "info").lower() != f["severity"].lower():
        return False
    if "result" in f and (evt.get("result") or "").lower() != f["result"].lower():
        return False
    if "action" in f and f["action"].lower() not in (evt.get("action") or "").lower():
        return False
    if "source" in f and (evt.get("source_file") or "").lower() != f["source"].lower():
        return False
    if "source_file" in f and (evt.get("source_file") or "").lower() != f["source_file"].lower():
        return False
    if "id" in f and (evt.get("id") or "") != f["id"]:
        return False
    if "actor" in f:
        actor = evt.get("actor") or {}
        needle = f["actor"].lower()
        hay = ((actor.get("id") or "") + " " + (actor.get("name") or "") + " " + (actor.get("kind") or "")).lower()
        if needle not in hay:
            return False
    if "resource" in f:
        res = evt.get("resource") or {}
        needle = f["resource"].lower()
        hay = ((res.get("type") or "") + " " + (res.get("id") or "")).lower()
        if needle not in hay:
            return False
    if "since" in f:
        try:
            if (evt.get("ts") or "") < f["since"]:
                return False
        except Exception:
            pass
    if "until" in f:
        try:
            if (evt.get("ts") or "") > f["until"]:
                return False
        except Exception:
            pass
    if "exclude" in f:
        excludes = [x.strip().lower() for x in f["exclude"].split(",") if x.strip()]
        blob = _json_stx.dumps(evt, default=str).lower()
        for ex in excludes:
            if ex and ex in blob:
                return False
    # text search across full event
    if parsed["text"]:
        blob = _json_stx.dumps(evt, default=str).lower()
        if parsed["text"] not in blob:
            return False
    return True


@app.get("/api/audit/query")
async def audit_query(q: str = "", limit: int = 200, source: str = ""):
    """Advanced DSL query on the master file."""
    if not _AUDIT_AVAILABLE:
        return {"ok": False, "error": "audit module not available"}
    parsed = _dsl_parse(q)

    # Load all master events
    try:
        all_events = _audit.read_master(limit=1000000)
    except Exception as e:
