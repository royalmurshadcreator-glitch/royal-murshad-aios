                    raise Exception("No output mp4 for " + kind)
                _sh_stx.copy2(str(outs[0]), str(dest))
                _ANCHOR_JOBS[job_id]["log_lines"].append("Saved " + kind + " -> " + str(dest))

            meta["last_built"] = _dt5.now().isoformat()
            _anchor_meta_save(meta)
