@app.post("/api/siteforge/projects/{pid}/edit")
def _sfsp_edit(pid: str, body: dict = {}):
    instruction = body.get("instruction", "").strip()
    if not instruction:
        return {"ok": False, "error": "instruction required"}
    d = _dragon_load_json("siteforge_store.json", {"projects": []})
    proj = next((p for p in d.get("projects", []) if p.get("id") == pid), None)
    if not proj:
        return {"ok": False, "error": "not found"}
    current = proj.get("export_html", proj.get("preview_html", ""))
    prompt = f"""You are editing an existing HTML page. Apply this change: "{instruction}".

Current HTML:
{current[:3500]}

Output ONLY the complete updated HTML. No markdown. No explanation. Keep the same overall structure but apply the change."""
    try:
        r = requests.post(_OLLAMA + "/api/generate", json={
            "model": _MODEL_FAST, "prompt": prompt, "stream": False,
            "options": {"temperature": 0.6, "num_predict": 400}
        }, timeout=600)
        r.raise_for_status()
        out = r.json().get("response", "").strip()
        if "```" in out:
            parts = out.split("```")
            if len(parts) >= 2:
                out = parts[1]
                for prefix in ("html\n", "HTML\n", "html", "HTML"):
                    if out.startswith(prefix):
                        out = out[len(prefix):]
                        break
        out = out.strip()
        if out and "<html" in out.lower():
            proj["preview_html"] = out
            proj["export_html"] = out
            proj["last_edit"] = instruction
            proj["edited_at"] = _sfsp_now()
            _dragon_save_json("siteforge_store.json", d)
            return {"ok": True, "project": proj}
        return {"ok": False, "error": "empty or invalid HTML"}
    except Exception as e:
        return {"ok": False, "error": f"{type(e).__name__}: {str(e)[:100]}"}

