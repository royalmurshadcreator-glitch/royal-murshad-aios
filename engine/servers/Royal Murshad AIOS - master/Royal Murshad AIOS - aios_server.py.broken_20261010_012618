import base64 as _b64_stx
import re as _re_stx

_STUDIO_UPLOADS = _Path_stx(ROOT) / "videos" / "_uploads"

@app.post("/api/studio/upload-image")
async def studio_upload_image(request: _Req_studio):
    body = await request.json()
    data = (body.get("data_base64") or "").strip()
    filename = (body.get("filename") or "upload.jpg").strip()
    if not data:
        return {"ok": False, "error": "no image data"}

    # strip data URL prefix if present
    if data.startswith("data:"):
        try:
            data = data.split(",", 1)[1]
        except Exception:
            return {"ok": False, "error": "malformed data URL"}

    try:
        raw = _b64_stx.b64decode(data)
    except Exception as e:
        return {"ok": False, "error": "base64 decode failed: " + str(e)}

    if len(raw) < 100:
        return {"ok": False, "error": "image too small"}
    if len(raw) > 25 * 1024 * 1024:
        return {"ok": False, "error": "image too large (max 25MB)"}

    _STUDIO_UPLOADS.mkdir(parents=True, exist_ok=True)
    safe = _re_stx.sub(r"[^a-zA-Z0-9._-]", "_", filename)
    ts = _dt_stx.now().strftime("%Y%m%d_%H%M%S")
    out_name = "upload_" + ts + "_" + safe
    out_path = _STUDIO_UPLOADS / out_name
    out_path.write_bytes(raw)

    return {
        "ok": True,
        "filename": out_name,
        "path": str(out_path),
        "url": "/videos/_uploads/" + out_name,
        "size_bytes": len(raw),
    }
