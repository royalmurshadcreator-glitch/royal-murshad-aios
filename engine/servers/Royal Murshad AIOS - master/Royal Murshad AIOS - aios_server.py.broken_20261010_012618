import threading as _eye_threading
from pathlib import Path as _EyePath
from datetime import datetime as _EyeDT, timezone as _EyeTZ

_EYE_ROOT       = _EyePath(r"D:\\AIOS\\05_MODELS\\aios_vision")
_EYE_LOG        = _EYE_ROOT / "eye_state.jsonl"
_EYE_SNAPSHOT   = _EYE_ROOT / "eye_snapshot.jpg"
_EYE_LOCK       = _eye_threading.Lock()
_EYE_LATEST     = {"ok": False, "reason": "no data yet"}
_EYE_HISTORY    = []          # last N in memory
_EYE_HISTORY_MAX = 300

def _eye_now_iso():
    return _EyeDT.now(_EyeTZ.utc).isoformat()

def _eye_reload_from_log():
    """Warm the memory buffer from the log on first request."""
    global _EYE_HISTORY, _EYE_LATEST
    try:
        if _EYE_LOG.exists():
            with _EYE_LOG.open("r", encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        _EYE_HISTORY.append(json.loads(line))
                    except Exception:
                        continue
            _EYE_HISTORY = _EYE_HISTORY[-_EYE_HISTORY_MAX:]
            if _EYE_HISTORY:
                _EYE_LATEST = _EYE_HISTORY[-1]
    except Exception:
        pass
