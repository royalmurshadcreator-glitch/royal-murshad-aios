@app.post("/api/keys/test/{key_id}")
def keys_test(key_id: str):
    """Test a saved key. Currently supports: stripe."""
    entry = _KEYS.get_key(key_id)
    if not entry.get("ok"):
        return {"ok": False, "error": "not_found"}

    platform = entry.get("platform", "").lower()

    if platform == "stripe" or key_id.startswith("stripe"):
        # Test via stripe_connector
        import aios_stripe_connector as _STRIPE
        try:
            _STRIPE.save_credentials(entry["key"], "test" if "test" in entry["key"] else "live")
            result = _STRIPE.test_connection()
            if result.get("ok"):
                msg = "Balance: $" + str(result.get("balance_available", 0))
                _KEYS.record_test(key_id, "valid", msg)
                return {"ok": True, "status": "valid", "message": msg}
            else:
                reason = result.get("error", "unknown")
