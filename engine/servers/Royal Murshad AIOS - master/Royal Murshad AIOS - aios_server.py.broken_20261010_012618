@app.get("/api/audit/anomalies")
async def audit_anomalies(hours: int = 24):
    """Detect anomalies: bursts, off-hours, new actors, high failure rate."""
    if not _AUDIT_AVAILABLE:
        return {"ok": False, "error": "audit module not available"}
    try:
        events = _audit.read_all(limit=100000)
    except Exception as e:
        return {"ok": False, "error": str(e)}

    now = _dt5.utcnow()
    window_start = now - _td5(hours=hours)
    window_start_iso = window_start.isoformat()

    in_window = []
    for e in events:
        ts = e.get("ts") or ""
        if ts and ts >= window_start_iso:
            in_window.append(e)

    anomalies = []

    # ----- A. Burst detection: any 5-minute window with > 30 events -----
    burst_seconds = 300
    burst_threshold = 30
    buckets_5m = {}
    for e in in_window:
        ts = e.get("ts") or ""
        try:
            dt = _dt5.fromisoformat(ts.replace("Z", "+00:00")).replace(tzinfo=None)
        except Exception:
            continue
        # round down to 5 min
        epoch = int(dt.timestamp())
        slot = epoch - (epoch % burst_seconds)
        buckets_5m[slot] = buckets_5m.get(slot, 0) + 1

    peak_slot = None
    peak_count = 0
    for slot, cnt in buckets_5m.items():
        if cnt > peak_count:
            peak_count = cnt
            peak_slot = slot
    if peak_count >= burst_threshold:
        peak_dt = _dt5.fromtimestamp(peak_slot)
        anomalies.append({
            "kind": "burst",
            "severity": "warn" if peak_count < 100 else "error",
            "title": "Event burst detected",
            "detail": str(peak_count) + " events in 5 minutes at " + peak_dt.strftime("%H:%M"),
            "count": peak_count,
            "at": peak_dt.isoformat(),
        })

    # ----- B. Off-hours activity (23:00 - 06:00 UTC) -----
    off_count = 0
    off_examples = []
    for e in in_window:
        ts = e.get("ts") or ""
        try:
            dt = _dt5.fromisoformat(ts.replace("Z", "+00:00")).replace(tzinfo=None)
        except Exception:
            continue
        if dt.hour >= 23 or dt.hour < 6:
            off_count += 1
            if len(off_examples) < 3:
                off_examples.append({
                    "ts": dt.isoformat(),
                    "action": e.get("action"),
                    "actor": (e.get("actor") or {}).get("name"),
                })
    if off_count > 0:
        anomalies.append({
            "kind": "off_hours",
            "severity": "info" if off_count < 50 else "warn",
            "title": "Off-hours activity",
            "detail": str(off_count) + " events between 23:00-06:00 UTC",
            "count": off_count,
            "examples": off_examples,
        })

    # ----- C. High failure rate (>20% failed events) -----
    total = len(in_window)
    failures = sum(1 for e in in_window if (e.get("result") or "") == "failed")
    if total > 0:
        fail_pct = round((failures / total) * 100.0, 1)
        if fail_pct > 20:
            anomalies.append({
                "kind": "high_failure",
                "severity": "error",
                "title": "High failure rate",
                "detail": str(fail_pct) + "% of events failed (" + str(failures) + " of " + str(total) + ")",
                "percent": fail_pct,
                "count": failures,
            })

    # ----- D. New actors (first seen in this window) -----
    seen_before = set()
    seen_window = {}
    for e in events:
        ts = e.get("ts") or ""
        actor = (e.get("actor") or {}).get("id") or "unknown"
        if ts and ts < window_start_iso:
            seen_before.add(actor)
        elif ts:
            if actor not in seen_window:
                seen_window[actor] = ts
    new_actors = []
    for actor, first_ts in seen_window.items():
        if actor not in seen_before:
            new_actors.append({"actor_id": actor, "first_seen": first_ts})
    if new_actors:
        anomalies.append({
            "kind": "new_actor",
            "severity": "info",
            "title": "New actor" + ("s" if len(new_actors) > 1 else ""),
            "detail": str(len(new_actors)) + " actor(s) seen for first time in this window",
            "new_actors": new_actors[:5],
            "count": len(new_actors),
        })

    # ----- E. Error concentration (>3 errors from one actor) -----
    actor_errors = {}
    for e in in_window:
        if (e.get("severity") or "") in ("error", "critical") or (e.get("result") or "") == "failed":
            actor = (e.get("actor") or {}).get("id") or "unknown"
            actor_errors[actor] = actor_errors.get(actor, 0) + 1
    for actor, cnt in actor_errors.items():
        if cnt >= 3:
            anomalies.append({
                "kind": "error_concentration",
                "severity": "warn",
                "title": "Error concentration",
                "detail": str(cnt) + " errors from actor " + actor,
                "actor_id": actor,
                "count": cnt,
            })

    # Sort by severity
    sev_order = {"error": 0, "warn": 1, "info": 2}
    anomalies.sort(key=lambda x: sev_order.get(x.get("severity", "info"), 3))

    return {
        "ok": True,
        "hours": hours,
        "window_start": window_start_iso,
        "events_in_window": total,
        "anomaly_count": len(anomalies),
        "anomalies": anomalies,
    }
# --- end audit phase 7 ---

