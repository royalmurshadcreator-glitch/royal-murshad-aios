async def audit_events_cursor(limit: int = 50, before_ts: str = "", after_ts: str = ""):
    if not _AUDIT_AVAILABLE:
        return {"ok": False, "error": "audit unavailable"}
    try:
        events = _audit.read_master(limit=200000)
    except Exception as e:
        return {"ok": False, "error": str(e)}
    events.sort(key=lambda x: str(x.get("ts") or ""), reverse=True)
    if before_ts:
        events = [e for e in events if (e.get("ts") or "") < before_ts]
    if after_ts:
        events = [e for e in events if (e.get("ts") or "") > after_ts]
    page = events[:limit]
    next_cursor = page[-1].get("ts") if page else None
    has_more = len(events) > limit
    return {"ok": True, "count": len(page), "has_more": has_more, "next_cursor": next_cursor, "events": page}
