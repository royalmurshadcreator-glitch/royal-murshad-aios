from typing import Dict as _Dict
from pydantic import BaseModel as _BaseModel2
class _BulkSetBody(_BaseModel2):
    provider: str
    values: _Dict[str, str]

@app.post("/api/keys/set_provider")
def api_keys_set_provider(body: _BulkSetBody):
    """Save all keys for a provider at once."""
    if body.provider not in PROVIDER_TEMPLATES:
        return {"ok": False, "error": "unknown provider: " + body.provider}
    expected = {f["id"] for f in PROVIDER_TEMPLATES[body.provider]["fields"]}
    saved = []
    errors = []
    try:
        import aios_key_vault as _kv
    except Exception as e:
        return {"ok": False, "error": "key_vault unavailable: " + str(e)}
    for field_id, value in body.values.items():
        if field_id not in expected:
            errors.append("unexpected field: " + field_id)
            continue
        if not value:
            continue
        try:
            _kv.save_key(field_id, value, label=field_id, platform=body.provider)
            saved.append(field_id)
        except Exception as e:
            errors.append(field_id + ": " + str(e))
    return {"ok": len(errors) == 0, "saved": saved, "errors": errors}

@app.get("/api/keys/provider_status/{provider}")
def api_keys_provider_status(provider: str):
    """Return which keys for a provider are set and which are missing."""
    if provider not in PROVIDER_TEMPLATES:
        return {"ok": False, "error": "unknown provider"}
    try:
        import aios_key_vault as _kv
    except Exception as e:
        return {"ok": False, "error": str(e)}
    all_keys = {k["id"]: k for k in (_kv.list_keys().get("keys") or [])}
    out = []
    for f in PROVIDER_TEMPLATES[provider]["fields"]:
        k = all_keys.get(f["id"])
        out.append({
            "id": f["id"],
            "label": f["label"],
            "hint": f.get("hint"),
            "secret": f.get("secret", False),
            "set": bool(k),
            "masked": (k or {}).get("masked"),
        })
    configured = sum(1 for x in out if x["set"])
    return {"ok": True, "provider": provider, "fields": out,
            "configured": configured, "total": len(out)}

