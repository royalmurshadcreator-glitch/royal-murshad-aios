        "music": _ASSETS_MUSIC,
        "presenters": _ASSETS_PRESENTERS,
        "templates": _ASSETS_TEMPLATES,
    }[cat]

    safe = _re_assets.sub(r"[^a-zA-Z0-9._-]", "_", filename)
    ts = _dt_assets.now().strftime("%Y%m%d_%H%M%S")
    out_name = ts + "_" + safe
    out_path = folder / out_name
    out_path.write_bytes(raw)

    return {
        "ok": True,
        "category": cat,
        "filename": out_name,
        "path": str(out_path),
