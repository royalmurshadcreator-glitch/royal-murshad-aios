import json as _json_stx
import os as _os_stx
from pathlib import Path as _Path_stx
from datetime import datetime as _dt_stx
import subprocess as _sp_stx
import threading as _th_stx
import uuid as _uuid_stx

_STUDIO_VIDEOS = _Path_stx(ROOT) / "videos"
_STUDIO_JOBS = {}

@app.get("/api/studio/stats")
async def studio_stats():
    videos = list(_STUDIO_VIDEOS.glob("ASG_*.mp4"))
    total_bytes = sum(v.stat().st_size for v in videos)
    today = _dt_stx.now().date()
    today_count = sum(1 for v in videos if _dt_stx.fromtimestamp(v.stat().st_mtime).date() == today)
    return {
        "ok": True,
        "total_videos": len(videos),
        "total_bytes": total_bytes,
        "total_mb": round(total_bytes / 1024 / 1024, 2),
        "today_count": today_count,
    }

@app.get("/api/studio/library")
async def studio_library():
    videos = []
    for v in sorted(_STUDIO_VIDEOS.glob("ASG_*.mp4"), key=lambda p: p.stat().st_mtime, reverse=True):
        st = v.stat()
        videos.append({
            "name": v.name,
            "size_mb": round(st.st_size / 1024 / 1024, 2),
            "modified": _dt_stx.fromtimestamp(st.st_mtime).isoformat(),
            "url": "/videos/" + v.name,
        })
    return {"ok": True, "count": len(videos), "videos": videos}

@app.get("/api/studio/jobs")
async def studio_jobs():
    jobs = []
    for jid, j in _STUDIO_JOBS.items():
        jobs.append({
            "id": jid,
            "status": j["status"],
            "prompt": j["prompt"],
            "started_at": j["started_at"],
            "log_count": len(j["log_lines"]),
        })
