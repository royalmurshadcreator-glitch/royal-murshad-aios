from datetime import datetime as _dt11, timedelta as _td11
from pathlib import Path as _Path11

@app.get("/api/studio/analytics")
async def studio_analytics():
    """Return aggregated stats across all videos and checkpoints."""
    videos_dir = _Path11(ROOT) / "videos"
    jobs_dir = videos_dir / "_jobs"
    videos = sorted(videos_dir.glob("ASG_*.mp4"), key=lambda x: x.stat().st_mtime)

    # Build 14-day buckets
    now = _dt11.now()
    buckets = {}
    for i in range(14):
        d = (now - _td11(days=13 - i)).strftime("%Y-%m-%d")
        buckets[d] = {"date": d, "count": 0, "size_mb": 0.0}

    total_size = 0
    largest = []
    for v in videos:
        st = v.stat()
        d = _dt11.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d")
        if d in buckets:
            buckets[d]["count"] += 1
            buckets[d]["size_mb"] = round(buckets[d]["size_mb"] + st.st_size / 1024 / 1024, 2)
        total_size += st.st_size
        largest.append({
            "name": v.name,
            "size_mb": round(st.st_size / 1024 / 1024, 2),
            "modified": _dt11.fromtimestamp(st.st_mtime).isoformat(),
        })

    largest.sort(key=lambda x: x["size_mb"], reverse=True)
    largest = largest[:5]

    # Job stats from checkpoints
    total_jobs = 0
    completed_jobs = 0
    failed_jobs = 0
    if jobs_dir.exists():
        for j in jobs_dir.glob("*.json"):
            try:
                st_data = _json_stx.loads(j.read_text(encoding="utf-8"))
                stages = st_data.get("stages_done", [])
                total_jobs += 1
                if "assemble" in stages:
                    completed_jobs += 1
                else:
                    failed_jobs += 1
            except Exception:
                continue

    # Success rate
    success_rate = 100.0
    if total_jobs > 0:
        success_rate = round(completed_jobs * 100.0 / total_jobs, 1)
    elif len(videos) > 0:
        success_rate = 100.0

    # Avg size
    avg_size_mb = round(total_size / len(videos) / 1024 / 1024, 2) if videos else 0

    # First/last video dates
    first_video = videos[0].name if videos else None
    last_video = videos[-1].name if videos else None

    return {
        "ok": True,
        "totals": {
            "videos": len(videos),
            "size_mb": round(total_size / 1024 / 1024, 2),
            "avg_size_mb": avg_size_mb,
            "total_jobs": total_jobs,
            "completed_jobs": completed_jobs,
            "failed_jobs": failed_jobs,
            "success_rate": success_rate,
        },
        "daily": list(buckets.values()),
        "largest": largest,
        "first_video": first_video,
        "last_video": last_video,
    }

