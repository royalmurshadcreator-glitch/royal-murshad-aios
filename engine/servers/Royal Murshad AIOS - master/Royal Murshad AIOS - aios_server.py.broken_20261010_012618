from datetime import datetime as _dt5, timedelta as _td5
from collections import defaultdict as _dd5

@app.get("/api/audit/timeline")
async def audit_timeline(hours: int = 24, bucket_minutes: int = 60):
    """Return bucketed event counts for timeline visualization."""
    if not _AUDIT_AVAILABLE:
        return {"ok": False, "error": "audit module not available"}

    try:
        events = _audit.read_all(limit=100000)
    except Exception as e:
        return {"ok": False, "error": str(e)}

    # Establish window
    now = _dt5.utcnow()
    start = now - _td5(hours=hours)
    start_iso = start.isoformat()

    # Buckets
    num_buckets = max(1, hours * 60 // max(1, bucket_minutes))
    bucket_sec = bucket_minutes * 60
    buckets = []
    for i in range(num_buckets):
        b_start = start + _td5(seconds=i * bucket_sec)
        b_end = b_start + _td5(seconds=bucket_sec)
        buckets.append({
            "start": b_start.isoformat(),
            "end": b_end.isoformat(),
            "count": 0,
            "by_category": {},
            "by_severity": {"info": 0, "warn": 0, "error": 0, "critical": 0},
        })

    # Categorize
    matched = 0
    for e in events:
        ts = e.get("ts") or ""
        if not ts or ts < start_iso:
            continue
        # Find bucket
        try:
            evt_dt = _dt5.fromisoformat(ts.replace("Z", "+00:00")).replace(tzinfo=None)
        except Exception:
            continue
        offset_sec = (evt_dt - start).total_seconds()
        if offset_sec < 0 or offset_sec >= num_buckets * bucket_sec:
            continue
        idx = int(offset_sec // bucket_sec)
        if 0 <= idx < num_buckets:
            buckets[idx]["count"] += 1
            cat = e.get("category") or "unknown"
            buckets[idx]["by_category"][cat] = buckets[idx]["by_category"].get(cat, 0) + 1
            sev = e.get("severity") or "info"
            if sev in buckets[idx]["by_severity"]:
                buckets[idx]["by_severity"][sev] += 1
            matched += 1

    # Peak
    peak = max((b["count"] for b in buckets), default=0)

    return {
        "ok": True,
        "window": {
            "start": start_iso,
            "end": now.isoformat(),
            "hours": hours,
            "bucket_minutes": bucket_minutes,
            "num_buckets": num_buckets,
        },
        "matched_events": matched,
        "peak": peak,
        "buckets": buckets,
    }


