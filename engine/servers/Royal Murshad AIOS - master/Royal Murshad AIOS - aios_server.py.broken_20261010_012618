@app.get("/api/audit/actors/stats")
async def audit_actor_stats(days: int = 7):
    """Detailed per-actor statistics."""
    if not _AUDIT_AVAILABLE:
        return {"ok": False, "error": "audit module not available"}
    try:
        events = _audit.read_all(limit=100000)
    except Exception as e:
        return {"ok": False, "error": str(e)}

    now = _dt5.utcnow()
    window_start = (now - _td5(days=days)).isoformat()

    actors = {}
    for e in events:
        ts = e.get("ts") or ""
        if not ts or ts < window_start:
            continue
        actor = e.get("actor") or {}
        aid = actor.get("id") or "unknown"
        aname = actor.get("name") or aid
        akind = actor.get("kind") or "unknown"

        if aid not in actors:
            actors[aid] = {
                "id": aid, "name": aname, "kind": akind,
                "total": 0, "ok": 0, "failed": 0, "blocked": 0,
                "by_category": {}, "by_severity": {"info": 0, "warn": 0, "error": 0, "critical": 0},
                "first_seen": ts, "last_seen": ts,
                "actions": {},
            }
        a = actors[aid]
        a["total"] += 1
        res = e.get("result") or "ok"
        if res in ("ok", "success"):
            a["ok"] += 1
        elif res == "failed":
            a["failed"] += 1
        elif res == "blocked":
            a["blocked"] += 1
        cat = e.get("category") or "unknown"
        a["by_category"][cat] = a["by_category"].get(cat, 0) + 1
        sev = e.get("severity") or "info"
        if sev in a["by_severity"]:
            a["by_severity"][sev] += 1
        action = e.get("action") or "unknown"
        a["actions"][action] = a["actions"].get(action, 0) + 1
        if ts < a["first_seen"]:
            a["first_seen"] = ts
        if ts > a["last_seen"]:
            a["last_seen"] = ts

    # Compute success rate + top actions
    for aid, a in actors.items():
        if a["total"] > 0:
            a["success_rate"] = round(a["ok"] * 100.0 / a["total"], 1)
        else:
            a["success_rate"] = 0.0
        top_actions = sorted(a["actions"].items(), key=lambda kv: -kv[1])[:5]
        a["top_actions"] = [{"action": k, "count": v} for k, v in top_actions]
        # Remove raw dicts to keep response small
        del a["actions"]

    # Sort by total desc
    ordered = sorted(actors.values(), key=lambda x: -x["total"])
    return {
        "ok": True,
        "days": days,
        "actor_count": len(ordered),
        "actors": ordered,
    }


