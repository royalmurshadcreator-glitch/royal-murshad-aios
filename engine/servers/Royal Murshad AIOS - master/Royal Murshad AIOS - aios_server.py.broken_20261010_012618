            "last_used": k.get("last_used"),
        } for k in keys],
    }

@app.post("/api/studio/keys")
async def studio_keys_add(request: _Req_studio):
    body = await request.json()
    key = (body.get("key") or "").strip()
    label = (body.get("label") or "").strip() or ("Agnes Key " + str(len(_get_keys_list()) + 1))
    if not key:
        return {"ok": False, "error": "empty key"}
    cfg = _load_studio_cfg()
