        return {"ok": False, "reason": "chat not loaded"}
    cid = (body or {}).get("conversation_id", "")
    msg = (body or {}).get("message", "")
    model = (body or {}).get("model")
    if not msg:
        return {"ok": False, "error": "empty message"}
    # --- Phase A: guardrail scan ---
    try:
        import sys as _guard_sys
        _GUARD_TOOLS = r"D:\\AIOS\\06_TOOLS"
        if _GUARD_TOOLS not in _guard_sys.path:
            _guard_sys.path.insert(0, _GUARD_TOOLS)
        from aios_guardrails import scan_input as _guard_scan
        _g = _guard_scan(msg)
        if _g.get("risk") == "high":
            return {
                "ok": False,
                "error": "blocked_by_guardrails",
                "risk": "high",
                "matches": [m.get("pattern") for m in _g.get("matches", [])]
            }
    except Exception:
        pass
    # --- end guardrail scan ---
    _p14_result = _chat_engine.send(cid, msg, model=model)

    # --- Phase 14: verification + metacognition + social ---
    try:
        if isinstance(_p14_result, dict):
            import sys as _p14_sys
            _P14_TOOLS = r"D:\\AIOS\\06_TOOLS"
            if _P14_TOOLS not in _p14_sys.path:
                _p14_sys.path.insert(0, _P14_TOOLS)
            _am = _p14_result.get("assistant_message")
            _text = ""
            if isinstance(_am, dict):
                _text = _am.get("content", "") or ""
            elif isinstance(_am, str):
                _text = _am
            if _text:
                try:
                    import aios_verifier as _v
                    _p14_result["verification"] = _v.verify_response(_text, source="chat")
                except Exception:
                    pass
                try:
                    import metacognition as _m
                    _p14_result["metacognition"] = _m.calibrate(_text, question=msg, source="chat")
                except Exception:
                    pass
                try:
                    import social_layer as _s
                    _p14_result["social"] = _s.check_tone(_text, source="chat")
                except Exception:
                    pass
    except Exception:
        pass
    # --- end Phase 14 ---

    return _p14_result

