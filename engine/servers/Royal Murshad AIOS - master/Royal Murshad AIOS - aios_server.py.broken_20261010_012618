@app.post("/api/studio/jobs/start")
async def studio_jobs_start(request: _Req_studio):
    body = await request.json()
    topic = body.get("topic", "Business")
    ratio = body.get("ratio", "9:16")
    voice = body.get("voice", "en-US-ChristopherNeural")
    model_version = body.get("model_version", "2.0")
    subtitles = bool(body.get("subtitles", False))
    srt_model = body.get("srt_model", "base")
    scenes = int(body.get("scenes", 6))
    sec = int(body.get("sec_per_scene", 10))
    use_anchor = bool(body.get("use_anchor", False))

    job_id = _uuid_stx.uuid4().hex[:12]
    _STUDIO_JOBS[job_id] = {
        "status": "running",
        "prompt": topic,
        "started_at": _dt_stx.now().isoformat(),
        "log_lines": [],
        "subtitles": subtitles,
    }

    def run_job():
        gen = _os_stx.path.join(ROOT, "static", "studio", "generator.py")
        py = _os_stx.path.join(ROOT, ".venv", "Scripts", "python.exe")
        args = [
            py, gen, topic,
            "--ratio", ratio,
            "--voice", voice,
            "--model-version", model_version,
            "--scenes", str(scenes),
            "--sec", str(sec),
        ]
        if subtitles:
            args.append("--subtitles")
            args.extend(["--srt-model", srt_model])
        if use_anchor:
            args.append("--anchor")
        if start_image:
            args.extend(["--start-image", start_image])
        args.extend(["--job-id", job_id])
        try:
            proc = _sp_stx.Popen(
                args,
                stdout=_sp_stx.PIPE,
                stderr=_sp_stx.STDOUT,
                text=True,
                bufsize=1,
            )
            for line in proc.stdout:
                _STUDIO_JOBS[job_id]["log_lines"].append(line.rstrip())
            proc.wait()
            _STUDIO_JOBS[job_id]["status"] = "completed" if proc.returncode == 0 else "failed"
        except Exception as e:
            _STUDIO_JOBS[job_id]["log_lines"].append("ERROR: " + str(e))
            _STUDIO_JOBS[job_id]["status"] = "failed"

    _th_stx.Thread(target=run_job, daemon=True).start()
    return {"ok": True, "job_id": job_id}

@app.get("/api/studio/jobs/{job_id}/resume-check")
async def studio_resume_check(job_id: str):
    """Check if a job can be resumed (checkpoint exists)."""
    ckpt = _Path_stx(ROOT) / "videos" / "_jobs" / (str(job_id) + ".json")
    if not ckpt.exists():
        return {"ok": True, "resumable": False, "reason": "no checkpoint file"}
    try:
        state = _json_stx.loads(ckpt.read_text(encoding="utf-8"))
    except Exception as e:
        return {"ok": True, "resumable": False, "reason": "checkpoint corrupted: " + str(e)}
    return {
        "ok": True,
        "resumable": True,
        "stages_done": state.get("stages_done", []),
        "topic": state.get("topic"),
        "started_at": state.get("started_at"),
        "updated_at": state.get("updated_at"),
    }

@app.post("/api/studio/jobs/{job_id}/resume")
async def studio_resume_job(job_id: str):
    """Resume a failed job from its checkpoint."""
    ckpt = _Path_stx(ROOT) / "videos" / "_jobs" / (str(job_id) + ".json")
    if not ckpt.exists():
        return {"ok": False, "error": "no checkpoint for job " + job_id}
    try:
        state = _json_stx.loads(ckpt.read_text(encoding="utf-8"))
    except Exception as e:
        return {"ok": False, "error": "checkpoint corrupted: " + str(e)}

    topic = state.get("topic") or "Resumed job"
    options = state.get("options") or {}

    # Extract saved options with defaults
    ratio = options.get("ratio", "9:16")
    voice = options.get("voice", "en-US-ChristopherNeural")
    model_version = options.get("model_version", "2.0")
    subtitles = bool(options.get("subtitles", False))
    srt_model = options.get("srt_model", "base")
    use_anchor = bool(options.get("use_anchor", False))
    start_image = options.get("start_image", "")
    scenes = int(options.get("scenes", 6))
    sec = int(options.get("sec_per_scene", 10))

    # New job_id for tracking, but reuse the same checkpoint file
    new_job_id = job_id
    _STUDIO_JOBS[new_job_id] = _STUDIO_JOBS.get(new_job_id) or {
        "status": "resuming",
        "prompt": topic + " (resumed)",
        "started_at": _dt_stx.now().isoformat(),
        "log_lines": [],
    }
    _STUDIO_JOBS[new_job_id]["status"] = "running"
    _STUDIO_JOBS[new_job_id]["log_lines"].append("=== RESUME requested ===")

    def run_resume():
        gen = _os_stx.path.join(ROOT, "static", "studio", "generator.py")
        py = _os_stx.path.join(ROOT, ".venv", "Scripts", "python.exe")
        args = [
            py, gen, topic,
            "--job-id", job_id,
            "--resume",
            "--ratio", ratio,
            "--voice", voice,
            "--model-version", model_version,
            "--scenes", str(scenes),
            "--sec", str(sec),
        ]
        if subtitles:
            args.append("--subtitles")
            args.extend(["--srt-model", srt_model])
        if use_anchor:
            args.append("--anchor")
        if start_image:
            args.extend(["--start-image", start_image])
        try:
            proc = _sp_stx.Popen(args, stdout=_sp_stx.PIPE, stderr=_sp_stx.STDOUT, text=True, bufsize=1)
            for line in proc.stdout:
                _STUDIO_JOBS[new_job_id]["log_lines"].append(line.rstrip())
            proc.wait()
