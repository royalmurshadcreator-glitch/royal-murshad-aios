    acc = next((a for a in d.get("accounts", []) if a.get("id") == aid), None)
    if not acc:
        return {"ok": False, "error": "account not found"}
    if not _SFSP_REAL:
        return {"ok": False, "error": "worker modules not loaded"}
    handle = acc.get("handle", "")
    platform = acc.get("platform", "Instagram").lower()
    try:
        import threading as _t
        result_holder = {}
        def _run():
            try:
                result_holder["r"] = _spworker.run_worker(handle, platform, actions, headless=headless)
            except Exception as ex:
                result_holder["r"] = {"ok": False, "error": str(ex)}
        th = _t.Thread(target=_run, daemon=True)
        th.start()
        th.join(timeout=120)
        r = result_holder.get("r", {"ok": False, "error": "timeout"})
        acc["last_engage"] = _sfsp_now()
        acc["last_result"] = r
        _dragon_save_json("socialpulse_store.json", d)
        return r
    except Exception as e:
        return {"ok": False, "error": str(e)}

