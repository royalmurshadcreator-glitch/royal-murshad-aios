@app.get("/api/audit/chain/verify")
async def audit_chain_verify():
    if not _AUDIT_AVAILABLE:
        return {"ok": False, "error": "audit module not available"}
    import json as _json_chain
    import hashlib as _hash_chain
    master = _audit.MASTER_FILE
    if not master.exists():
        return {"ok": True, "status": "empty", "total": 0, "verified": 0, "breaks": []}

    total = 0
    verified = 0
    breaks = []
    prev_hash = ""

    try:
        with master.open("r", encoding="utf-8") as f:
            for line_no, line in enumerate(f, start=1):
                line = line.strip()
                if not line:
                    continue
                total += 1
                try:
                    e = _json_chain.loads(line)
                except Exception as ex:
                    breaks.append({"line": line_no, "reason": "invalid json", "error": str(ex)})
                    if len(breaks) >= 20:
                        break
                    continue

                stored_hash = e.get("hash", "")
                stored_prev = e.get("prev_hash", "")

                # Check prev linkage
                if stored_prev != prev_hash:
                    breaks.append({
                        "line": line_no,
                        "reason": "prev_hash mismatch",
                        "expected_prev": prev_hash[:16],
                        "stored_prev": stored_prev[:16],
                    })
                    if len(breaks) >= 20:
                        break

                # Recompute hash
                clone = {k: v for k, v in e.items() if k not in ("hash", "prev_hash", "id")}
                canonical = _json_chain.dumps(clone, sort_keys=True, separators=(",", ":"), default=str)
                recomputed = _hash_chain.sha256((prev_hash + canonical).encode("utf-8")).hexdigest()

                if recomputed != stored_hash:
                    breaks.append({
                        "line": line_no,
                        "reason": "hash mismatch",
                        "expected_hash": recomputed[:16],
                        "stored_hash": stored_hash[:16],
                    })
                    if len(breaks) >= 20:
                        break
                else:
                    verified += 1

                prev_hash = stored_hash
    except Exception as ex:
        return {"ok": False, "error": str(ex)}

    return {
        "ok": True,
        "status": "intact" if not breaks else "tampered",
        "total": total,
        "verified": verified,
        "breaks": breaks,
        "head_hash": prev_hash,
    }

